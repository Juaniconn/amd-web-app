# PostgreSQL (required). Managed PostgreSQL in production.
# Local options: docker compose up -d  OR  npm run db:start
DATABASE_URL=postgresql://amd:amd@localhost:5432/amd_operations

# Better Auth (required). Secret must be at least 32 characters.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Optional. Extra origins/hosts for a future public domain (Cloudflare).
# LAN IPs like 192.168.x.x are already trusted automatically. Do not pin them here.
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_ALLOWED_HOSTS=

# Development seed only. Never use these values in production.
SEED_ADMIN_EMAIL=admin@amd-operations.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password
SEED_ADMIN_NAME=Administrador AMD

# Local file storage for Phase 3 documents (ADR-022). R2 when credentials exist.
STORAGE_DIR=.data/uploads

# Cloudflare R2 — production object storage. Not required for local Phase 3.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Cloudflare — hosting/WAF. Not required for local Phase 1.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Sentry — optional. Placeholder for later observability.
SENTRY_DSN=
