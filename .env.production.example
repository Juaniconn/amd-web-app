# Plantilla de entorno para PRODUCCIÓN en el VPS de Oracle Cloud.
#
# El archivo real vive en /opt/amd-erp/shared/.env.production con permisos 600
# y lo genera scripts/deploy/setup-vps.sh con secretos aleatorios.
# NUNCA se sube a git.

# ── Base de datos ────────────────────────────────────────────────────────
# PostgreSQL 16 en Docker, en el mismo VPS, escuchando solo en localhost.
DATABASE_URL=postgresql://amd:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/amd_operations

# Las lee docker-compose.prod.yml para crear el contenedor
POSTGRES_USER=amd
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
POSTGRES_DB=amd_operations

# ── Autenticación (Better Auth) ──────────────────────────────────────────
# Generar con: openssl rand -base64 48
BETTER_AUTH_SECRET=CAMBIA_ESTE_SECRETO

# DEBE ser https:// — useSecureAuthCookies() decide la marca Secure de la
# cookie según este prefijo. Con http:// el login responde 200 pero la
# sesión no persiste tras el redirect.
BETTER_AUTH_URL=https://erp.amdmexico.com
BETTER_AUTH_TRUSTED_ORIGINS=https://erp.amdmexico.com
BETTER_AUTH_ALLOWED_HOSTS=erp.amdmexico.com

# ── Usuario administrador inicial (solo lo usa el seed) ──────────────────
SEED_ADMIN_EMAIL=admin@amdmexico.com
SEED_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE
SEED_ADMIN_NAME=Administrador AMD

# ── Almacenamiento de archivos ───────────────────────────────────────────
# Planos DXF, PDFs de ingeniería y cotizaciones. Ruta compartida entre
# releases para que no se pierdan al desplegar. Oracle Free da 200 GB.
STORAGE_DIR=/opt/amd-erp/shared/uploads

# ── IA (cotización y predicción de atrasos) ──────────────────────────────
# Opcional: si está vacío, las funciones de IA quedan deshabilitadas.
CURSOR_API_KEY=

# ── Node ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# 127.0.0.1 a propósito: solo Caddy debe alcanzar la app, nunca internet.
HOSTNAME=127.0.0.1

# ── NO se usan en el despliegue de Oracle ────────────────────────────────
# Estas quedaron del plan anterior con Cloudflare Workers + R2.
# Con VPS los archivos van al disco local (STORAGE_DIR).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Opcional: monitoreo de errores
# SENTRY_DSN=
